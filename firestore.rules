rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Googleでログインしたユーザーのプロフィール。
    // 匿名認証(コメント削除用)も request.auth を持つため、"Googleでログイン済みか" は
    // sign_in_provider が 'google.com' であることまで確認して区別する。
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.resource.data.keys().hasOnly(
            ['provider', 'providerUid', 'displayName', 'email', 'photoURL', 'createdAt', 'updatedAt']
          )
        && request.resource.data.provider == 'google'
        && request.resource.data.providerUid is string
        && request.resource.data.displayName is string
        && request.resource.data.email is string
        && request.resource.data.photoURL is string
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if request.auth != null
        && request.auth.uid == userId
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['displayName', 'email', 'photoURL', 'updatedAt'])
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;

      // Wishlist(ほしいリスト)。ログイン必須の機能のため、匿名認証は弾く。
      match /wishlist/{cardId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null
          && request.auth.uid == userId
          && request.auth.token.firebase.sign_in_provider == 'google.com'
          && request.resource.data.keys().hasOnly(['cardId', 'userId', 'createdAt'])
          && request.resource.data.cardId == cardId
          && request.resource.data.userId == userId
          && request.resource.data.createdAt == request.time;
        allow update: if false;
        allow delete: if request.auth != null
          && request.auth.uid == userId
          && request.auth.token.firebase.sign_in_provider == 'google.com';
      }

      // マイコレクション(所持枚数)。ログイン必須。quantityは 0〜3(3は「3枚以上」を表す)。
      // 0枚に戻す場合はドキュメント自体を削除する運用(=未所持は「ドキュメントが無い」で表す)。
      match /collection/{cardId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if request.auth != null
          && request.auth.uid == userId
          && request.auth.token.firebase.sign_in_provider == 'google.com'
          && request.resource.data.keys().hasOnly(['cardId', 'userId', 'quantity', 'updatedAt'])
          && request.resource.data.cardId == cardId
          && request.resource.data.userId == userId
          && request.resource.data.quantity is int
          && request.resource.data.quantity >= 1
          && request.resource.data.quantity <= 3
          && request.resource.data.updatedAt == request.time;
        allow delete: if request.auth != null
          && request.auth.uid == userId
          && request.auth.token.firebase.sign_in_provider == 'google.com';
      }

      // マイデッキ。ログイン必須。無料会員の「3デッキまで」はUI側で案内・制御しており、
      // ここでは所有者チェックとデータ形状の検証のみ行う。
      match /decks/{deckId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null
          && request.auth.uid == userId
          && request.auth.token.firebase.sign_in_provider == 'google.com'
          && request.resource.data.keys().hasOnly(
              ['deckName', 'userId', 'cards', 'energyTypes', 'createdAt', 'updatedAt']
            )
          && request.resource.data.userId == userId
          && request.resource.data.deckName is string
          && request.resource.data.deckName.size() > 0
          && request.resource.data.deckName.size() <= 50
          && request.resource.data.cards is list
          && request.resource.data.cards.size() <= 20
          && request.resource.data.energyTypes is list
          && request.resource.data.energyTypes.size() <= 8
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;
        allow update: if request.auth != null
          && request.auth.uid == userId
          && request.auth.token.firebase.sign_in_provider == 'google.com'
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['deckName', 'cards', 'energyTypes', 'updatedAt'])
          && request.resource.data.deckName is string
          && request.resource.data.deckName.size() > 0
          && request.resource.data.deckName.size() <= 50
          && request.resource.data.cards is list
          && request.resource.data.cards.size() <= 20
          && request.resource.data.energyTypes is list
          && request.resource.data.energyTypes.size() <= 8
          && request.resource.data.updatedAt == request.time;
        allow delete: if request.auth != null
          && request.auth.uid == userId
          && request.auth.token.firebase.sign_in_provider == 'google.com';
      }
    }

    match /tradePosts/{postId} {
      allow read: if true;
      // 新規投稿はGoogleログイン必須(匿名認証だけでは不可)。既存の匿名投稿(userId無し)は
      // そのまま読み取り専用で残り続け、このルールの対象は今後の新規投稿のみ。
      allow create: if request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.resource.data.keys().hasOnly([
            'friendId', 'offerCardIds', 'wantCardIds', 'memo', 'createdAt',
            'authorDeviceId', 'commentCount', 'lastCommentAt', 'lastCommentAuthorId',
            'userId', 'nickname', 'closed'
          ])
        && request.resource.data.friendId is string
        && request.resource.data.friendId.matches('^[0-9]{10,20}$')
        && request.resource.data.offerCardIds is list
        && request.resource.data.offerCardIds.size() <= 10
        && request.resource.data.wantCardIds is list
        && request.resource.data.wantCardIds.size() <= 10
        && request.resource.data.memo is string
        && request.resource.data.memo.size() <= 200
        && request.resource.data.createdAt == request.time
        && request.resource.data.authorDeviceId is string
        && request.resource.data.authorDeviceId.size() <= 100
        && request.resource.data.commentCount == 0
        && request.resource.data.lastCommentAt == null
        && request.resource.data.lastCommentAuthorId == null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() > 0
        && request.resource.data.nickname.size() <= 20
        && request.resource.data.closed == false;
      allow update: if
        // コメント投稿時に件数・最終コメント情報だけを更新できるようにする(他フィールドの改ざんは不可)
        (request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['commentCount', 'lastCommentAt', 'lastCommentAuthorId'])
          && request.resource.data.commentCount == resource.data.get('commentCount', 0) + 1
          && request.resource.data.lastCommentAt == request.time
          && request.resource.data.lastCommentAuthorId is string
          && request.resource.data.lastCommentAuthorId.size() <= 100)
        ||
        // 投稿者本人による編集・募集終了の切り替え(トレード投稿管理ページ用)
        (request.auth != null
          && request.auth.token.firebase.sign_in_provider == 'google.com'
          && request.auth.uid == resource.data.get('userId', null)
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['friendId', 'offerCardIds', 'wantCardIds', 'memo', 'closed'])
          && request.resource.data.friendId is string
          && request.resource.data.friendId.matches('^[0-9]{10,20}$')
          && request.resource.data.offerCardIds is list
          && request.resource.data.offerCardIds.size() <= 10
          && request.resource.data.wantCardIds is list
          && request.resource.data.wantCardIds.size() <= 10
          && request.resource.data.memo is string
          && request.resource.data.memo.size() <= 200
          && request.resource.data.closed is bool);
      // 投稿者本人のみ削除可能(既存の匿名投稿はuserIdが無いため誰も削除できない)
      allow delete: if request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.uid == resource.data.get('userId', null);

      match /comments/{commentId} {
        allow read: if true;
        allow create: if request.auth != null
          && request.resource.data.keys().hasOnly(['nickname', 'text', 'createdAt', 'authorDeviceId', 'authorUid'])
          && request.resource.data.nickname is string
          && request.resource.data.nickname.size() <= 20
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 200
          && request.resource.data.createdAt == request.time
          && request.resource.data.authorDeviceId is string
          && request.resource.data.authorDeviceId.size() <= 100
          && request.resource.data.authorUid == request.auth.uid;
        allow update: if false;
        allow delete: if request.auth != null && request.auth.uid == resource.data.authorUid;
      }
    }

    // フッターの「ご意見・ご要望」フォーム。一覧表示はせず運営がConsole側で直接確認するため、
    // 読み取りは許可しない(トレード投稿のような公開掲示板ではないため)。
    match /feedback/{feedbackId} {
      allow read: if false;
      allow create: if request.resource.data.keys().hasOnly(
          ['message', 'contact', 'createdAt', 'authorDeviceId']
        )
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 1000
        && request.resource.data.contact is string
        && request.resource.data.contact.size() <= 200
        && request.resource.data.createdAt == request.time
        && request.resource.data.authorDeviceId is string
        && request.resource.data.authorDeviceId.size() <= 100;
      allow update: if false;
      allow delete: if false;
    }
  }
}
