rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Google/Appleでログイン済みか。匿名認証(コメント削除用UID発行など)も
    // request.auth を持つため、"実際にログインしているか" はsign_in_providerまで見て区別する。
    function isVerifiedSignIn() {
      return request.auth != null
        && (request.auth.token.firebase.sign_in_provider == 'google.com'
          || request.auth.token.firebase.sign_in_provider == 'apple.com');
    }

    // URLスパム・外部リンク誘導の最終防波堤。クライアント側のlib/contentFilter.tsにある
    // より広い禁止語チェックはここには展開していない(保守性の観点。詳細はdocs/operations/MODERATION.md)。
    // ここではクライアントを経由しない直接書き込みでも弾けるよう、分かりやすいURLパターンのみ検証する。
    function hasNoUrl(text) {
      return !text.matches('.*(https?://|www\\.).*');
    }

    // Google/Appleでログインしたユーザーのプロフィール。
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if isVerifiedSignIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(
            ['provider', 'providerUid', 'displayName', 'email', 'photoURL', 'createdAt', 'updatedAt']
          )
        && (request.resource.data.provider == 'google' || request.resource.data.provider == 'apple')
        && request.resource.data.providerUid is string
        && request.resource.data.displayName is string
        && request.resource.data.email is string
        && request.resource.data.photoURL is string
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isVerifiedSignIn()
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['displayName', 'email', 'photoURL', 'updatedAt'])
        && request.resource.data.updatedAt == request.time;
      // アカウント削除機能(Apple Guideline 5.1.1(v))のため、本人のみ自分のプロフィールを削除できる。
      allow delete: if isVerifiedSignIn() && request.auth.uid == userId;

      // Wishlist(ほしいリスト)。ログイン必須の機能のため、匿名認証は弾く。
      match /wishlist/{cardId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if isVerifiedSignIn()
          && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(['cardId', 'userId', 'createdAt'])
          && request.resource.data.cardId == cardId
          && request.resource.data.userId == userId
          && request.resource.data.createdAt == request.time;
        allow update: if false;
        allow delete: if isVerifiedSignIn() && request.auth.uid == userId;
      }

      // マイコレクション(所持枚数)。ログイン必須。quantityは 0〜3(3は「3枚以上」を表す)。
      // 0枚に戻す場合はドキュメント自体を削除する運用(=未所持は「ドキュメントが無い」で表す)。
      match /collection/{cardId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if isVerifiedSignIn()
          && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(['cardId', 'userId', 'quantity', 'updatedAt'])
          && request.resource.data.cardId == cardId
          && request.resource.data.userId == userId
          && request.resource.data.quantity is int
          && request.resource.data.quantity >= 1
          && request.resource.data.quantity <= 3
          && request.resource.data.updatedAt == request.time;
        allow delete: if isVerifiedSignIn() && request.auth.uid == userId;
      }

      // マイデッキ。ログイン必須。無料会員の「3デッキまで」は、ドキュメントIDを
      // slot-0/slot-1/slot-2 の3つだけに限定することでルール側でも強制している
      // (Firestoreのルールはコレクション内の件数を直接数えられないため、
      // 許可するIDを最初から3つに絞ることで同じ効果を得ている。lib/decks.tsと対応)。
      match /decks/{deckId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if isVerifiedSignIn()
          && request.auth.uid == userId
          && deckId in ['slot-0', 'slot-1', 'slot-2']
          && request.resource.data.keys().hasOnly(
              ['deckName', 'userId', 'cards', 'energyTypes', 'createdAt', 'updatedAt']
            )
          && request.resource.data.userId == userId
          && request.resource.data.deckName is string
          && request.resource.data.deckName.size() > 0
          && request.resource.data.deckName.size() <= 50
          && request.resource.data.cards is list
          && request.resource.data.cards.size() <= 20
          && request.resource.data.energyTypes is list
          && request.resource.data.energyTypes.size() <= 8
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;
        allow update: if isVerifiedSignIn()
          && request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['deckName', 'cards', 'energyTypes', 'updatedAt'])
          && request.resource.data.deckName is string
          && request.resource.data.deckName.size() > 0
          && request.resource.data.deckName.size() <= 50
          && request.resource.data.cards is list
          && request.resource.data.cards.size() <= 20
          && request.resource.data.energyTypes is list
          && request.resource.data.energyTypes.size() <= 8
          && request.resource.data.updatedAt == request.time;
        allow delete: if isVerifiedSignIn() && request.auth.uid == userId;
      }

      // ブロックしたユーザーの一覧。ログイン必須、自分のサブコレクションのみ読み書き可能。
      // 相手(ドキュメントIDがそのUID)を自分自身にはできない。
      match /blockedUsers/{blockedUid} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if isVerifiedSignIn()
          && request.auth.uid == userId
          && blockedUid != userId
          && request.resource.data.keys().hasOnly(['blockedUid', 'blockedNickname', 'createdAt'])
          && request.resource.data.blockedUid == blockedUid
          && (request.resource.data.blockedNickname == null || request.resource.data.blockedNickname is string)
          && request.resource.data.createdAt == request.time;
        allow update: if false;
        allow delete: if isVerifiedSignIn() && request.auth.uid == userId;
      }
    }

    // 投稿・コメントの通報。Apple App Store Guideline 1.2対応。
    // 通報した本人だけが自分の通報内容を読める(他ユーザーの通報内容は閲覧不可)。
    // 運営(自分)はFirebase Console側の管理者権限で確認する(詳細はdocs/operations/MODERATION.md)。
    match /reports/{reportId} {
      allow read: if request.auth != null && resource.data.reporterUid == request.auth.uid;
      // reportIdを `${reporterUid}_${targetType}_${targetId}` 形式に固定することで、
      // 同一ユーザーが同じ対象を2回目以降通報しようとした場合は"update"扱いになり、
      // allow update: if false により拒否される(=二重通報の防止)。
      allow create: if isVerifiedSignIn()
        && reportId == request.auth.uid + '_' + request.resource.data.targetType + '_' + request.resource.data.targetId
        && request.resource.data.keys().hasOnly(
            ['reporterUid', 'targetType', 'targetId', 'postId', 'targetAuthorUid', 'reason', 'details', 'createdAt', 'status']
          )
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.targetType in ['tradePost', 'comment']
        && request.resource.data.targetId is string
        && request.resource.data.targetId.size() > 0
        && request.resource.data.postId is string
        && request.resource.data.postId.size() > 0
        && (request.resource.data.targetAuthorUid == null || request.resource.data.targetAuthorUid is string)
        && request.resource.data.reason in ['inappropriate', 'harassment', 'spam', 'scam', 'personal_info', 'other']
        && request.resource.data.details is string
        && request.resource.data.details.size() <= 300
        && request.resource.data.createdAt == request.time
        && request.resource.data.status == 'open';
      allow update: if false;
      allow delete: if false;
    }

    match /tradePosts/{postId} {
      allow read: if true;
      // 新規投稿はGoogle/Appleログイン必須(匿名認証だけでは不可)。既存の匿名投稿(userId無し)は
      // そのまま読み取り専用で残り続け、このルールの対象は今後の新規投稿のみ。
      allow create: if isVerifiedSignIn()
        && request.resource.data.keys().hasOnly([
            'friendId', 'offerCardIds', 'wantCardIds', 'memo', 'createdAt',
            'authorDeviceId', 'commentCount', 'lastCommentAt', 'lastCommentAuthorId',
            'userId', 'nickname', 'closed'
          ])
        && request.resource.data.friendId is string
        && request.resource.data.friendId.matches('^[0-9]{10,20}$')
        && request.resource.data.offerCardIds is list
        && request.resource.data.offerCardIds.size() <= 10
        && request.resource.data.wantCardIds is list
        && request.resource.data.wantCardIds.size() <= 10
        && request.resource.data.memo is string
        && request.resource.data.memo.size() <= 200
        && hasNoUrl(request.resource.data.memo)
        && request.resource.data.createdAt == request.time
        && request.resource.data.authorDeviceId is string
        && request.resource.data.authorDeviceId.size() <= 100
        && request.resource.data.commentCount == 0
        && request.resource.data.lastCommentAt == null
        && request.resource.data.lastCommentAuthorId == null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() > 0
        && request.resource.data.nickname.size() <= 20
        && hasNoUrl(request.resource.data.nickname)
        && request.resource.data.closed == false;
      allow update: if
        // コメント投稿時に件数・最終コメント情報だけを更新できるようにする(他フィールドの改ざんは不可)
        (request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['commentCount', 'lastCommentAt', 'lastCommentAuthorId'])
          && request.resource.data.commentCount == resource.data.get('commentCount', 0) + 1
          && request.resource.data.lastCommentAt == request.time
          && request.resource.data.lastCommentAuthorId is string
          && request.resource.data.lastCommentAuthorId.size() <= 100)
        ||
        // 投稿者本人による編集・募集終了の切り替え(トレード投稿管理ページ用)
        (isVerifiedSignIn()
          && request.auth.uid == resource.data.get('userId', null)
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['friendId', 'offerCardIds', 'wantCardIds', 'memo', 'closed'])
          && request.resource.data.friendId is string
          && request.resource.data.friendId.matches('^[0-9]{10,20}$')
          && request.resource.data.offerCardIds is list
          && request.resource.data.offerCardIds.size() <= 10
          && request.resource.data.wantCardIds is list
          && request.resource.data.wantCardIds.size() <= 10
          && request.resource.data.memo is string
          && request.resource.data.memo.size() <= 200
          && hasNoUrl(request.resource.data.memo)
          && request.resource.data.closed is bool);
      // 投稿者本人のみ削除可能(既存の匿名投稿はuserIdが無いため誰も削除できない)
      allow delete: if isVerifiedSignIn() && request.auth.uid == resource.data.get('userId', null);

      match /comments/{commentId} {
        allow read: if true;
        // コメント投稿はGoogle/Appleログイン必須(閲覧はログイン不要のまま)。
        allow create: if isVerifiedSignIn()
          && request.resource.data.keys().hasOnly(['nickname', 'text', 'createdAt', 'authorDeviceId', 'authorUid'])
          && request.resource.data.nickname is string
          && request.resource.data.nickname.size() <= 20
          && hasNoUrl(request.resource.data.nickname)
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 200
          && hasNoUrl(request.resource.data.text)
          && request.resource.data.createdAt == request.time
          && request.resource.data.authorDeviceId is string
          && request.resource.data.authorDeviceId.size() <= 100
          && request.resource.data.authorUid == request.auth.uid;
        allow update: if false;
        allow delete: if request.auth != null && request.auth.uid == resource.data.authorUid;
      }
    }

    // フッターの「ご意見・ご要望」フォーム。一覧表示はせず運営がConsole側で直接確認するため、
    // 読み取りは許可しない(トレード投稿のような公開掲示板ではないため)。
    match /feedback/{feedbackId} {
      allow read: if false;
      allow create: if request.resource.data.keys().hasOnly(
          ['message', 'contact', 'createdAt', 'authorDeviceId']
        )
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 1000
        && request.resource.data.contact is string
        && request.resource.data.contact.size() <= 200
        && request.resource.data.createdAt == request.time
        && request.resource.data.authorDeviceId is string
        && request.resource.data.authorDeviceId.size() <= 100;
      allow update: if false;
      allow delete: if false;
    }
  }
}
